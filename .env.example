# Copy this file to .env and fill in what your chosen provider needs.
#   cp .env.example .env

# ---- Which LLM backend to use ----
# anthropic = Claude (paid API key)
# ollama    = free, local models on your own machine (no key, most private)
# openai    = any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio...)
PROVIDER=anthropic

# Model name. If left blank, a sensible default for the provider is used:
#   anthropic -> claude-haiku-4-5-20251001
#   ollama    -> llama3.2
#   openai    -> gpt-4o-mini
MODEL=

# Max tokens for the digest.
MAX_TOKENS=1024

# ---- anthropic (only if PROVIDER=anthropic) ----
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- ollama (only if PROVIDER=ollama) ----
# Install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ---- openai-compatible (only if PROVIDER=openai) ----
# Point OPENAI_BASE_URL at your provider:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   LM Studio   http://localhost:1234/v1   (local, no key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ---- WhatsApp / buffering (all optional) ----
SUMMARY_COMMAND=/summary
DEFAULT_HOURS=12
BUFFER_HOURS=24
MAX_PER_CHAT=300
CLEAR_AFTER_SUMMARY=true
AUTH_DIR=auth_info
